# Configuration Production pour VPS
# IMPORTANT: Remplacer toutes les valeurs par vos vraies valeurs de production

# Backend
NODE_ENV=production
PORT=3000
API_VERSION=v1

# Database (PostgreSQL)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=meteo_pro_production
DATABASE_USER=meteo_user
DATABASE_PASSWORD=CHANGEZ_MOI_MOT_DE_PASSE_FORT_ALEATOIRE

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGEZ_MOI_REDIS_PASSWORD_FORT

# JWT (IMPORTANT: Générer une clé secrète forte)
# Utilisez: openssl rand -base64 64
JWT_SECRET=CHANGEZ_MOI_CLE_JWT_SECRETE_TRES_LONGUE_ET_ALEATOIRE
JWT_EXPIRES_IN=7d

# Weather APIs
OPENWEATHER_API_KEY=votre_vraie_cle_openweather
METEOMATICS_USERNAME=votre_username_meteomatics
METEOMATICS_PASSWORD=votre_password_meteomatics
TOMORROW_IO_API_KEY=votre_cle_tomorrow_io

# Frontend URLs (HTTPS)
VITE_API_URL=https://meteoproapp.votredomaine.com
VITE_WS_URL=wss://meteoproapp.votredomaine.com

# CORS (domaine production)
CORS_ORIGIN=https://meteoproapp.votredomaine.com

# Email (SMTP pour notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email@gmail.com
SMTP_PASS=votre_mot_de_passe_application

# Mapbox (optionnel)
MAPBOX_ACCESS_TOKEN=votre_token_mapbox

# Domaine
DOMAIN=meteoproapp.votredomaine.com
EMAIL_ADMIN=admin@votredomaine.com

# Monitoring (optionnel)
SENTRY_DSN=votre_sentry_dsn_si_utilise
