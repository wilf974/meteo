# Backend configuration example
# Copiez ce fichier en .env et configurez selon votre environnement

# Port
PORT=5001

# CORS Origin - Frontend URL
# En développement : http://localhost:5173
# En production : https://votre-domaine.com
CORS_ORIGIN=http://localhost:5173

# API Version
API_VERSION=v1

# Node Environment
NODE_ENV=development

# Database (optionnel - backend fonctionne sans)
DATABASE_URL=postgresql://user:password@localhost:5432/meteo

# Redis (optionnel - backend fonctionne sans, mais améliore les performances)
REDIS_HOST=localhost
REDIS_PORT=6379

# Email (optionnel)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
